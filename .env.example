# Copia este archivo a ".env" y rellena los valores reales.
# ".env" nunca se commitea (ver .gitignore).

# --- Postgres (usado por docker-compose para crear el contenedor de base de datos) ---
POSTGRES_DB=enlaza
POSTGRES_USER=enlaza
POSTGRES_PASSWORD=change-me

# --- Datos de conexion que usa la app (en local, fuera de docker-compose, host=localhost) ---
DB_URL=jdbc:postgresql://localhost:5432/enlaza
DB_USERNAME=enlaza
DB_PASSWORD=change-me

# --- JWT ---
# Secreto usado para firmar los tokens (HS256). Genera uno propio, por ejemplo con:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-base64-secret
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Servidor ---
SERVER_PORT=8080
