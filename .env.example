# Copia este archivo a ".env" y rellena los valores reales.
# ".env" nunca se commitea (ver .gitignore).

# --- Postgres (usado por docker-compose para crear el contenedor de base de datos) ---
POSTGRES_DB=enlaza
POSTGRES_USER=enlaza
POSTGRES_PASSWORD=change-me

# --- Datos de conexion que usa la app (en local, fuera de docker-compose, host=localhost) ---
DB_URL=jdbc:postgresql://localhost:5432/enlaza
DB_USERNAME=enlaza
DB_PASSWORD=change-me

# --- JWT ---
# Secreto usado para firmar los tokens (HS256), debe ser Base64 valido.
# El valor de ejemplo es funcional pero publico: genera el tuyo con
#   openssl rand -base64 48
# antes de exponer una instancia real.
JWT_SECRET=OiIRwY28eyFI1sqLaK1q2eugprdSxxl2EEp861h7BbX5ljDv0wHoGdcQyZuMUqiZ
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Usuarios semilla (se crean automaticamente al arrancar si no existen) ---
# Publicos a proposito: permiten probar el despliegue de portfolio con los
# tres roles sin preparar datos a mano. Cambia ADMIN_PASSWORD si vas a exponer
# una instancia con datos reales.
ADMIN_EMAIL=admin@enlaza.dev
ADMIN_PASSWORD=Admin123!
DEMO_CONTABLE_EMAIL=contable@enlaza.dev
DEMO_CONTABLE_PASSWORD=Contable123!
DEMO_CLIENTE_EMAIL=cliente@enlaza.dev
DEMO_CLIENTE_PASSWORD=Cliente123!

# --- Servidor ---
SERVER_PORT=8080

# --- CORS (origen del frontend, servido aparte por nginx, nunca por Spring Boot) ---
CORS_ALLOWED_ORIGIN=http://localhost:8081
